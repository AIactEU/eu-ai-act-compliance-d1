+async function openDocGenerator(sysId,sysName){docSystemId=sysId;docCurrentSection=0;docFieldValues={};document.getElementById('docGenSystemName').textContent='For: '+sysName;openModal('docGenModal');try{const r=await(await fetch(`/api/systems/${sysId}/doc-template`,{credentials:'include'})).json();docSections=r.sections;buildDocForm();}catch(e){alert('Failed to load template');closeModal('docGenModal');}}
