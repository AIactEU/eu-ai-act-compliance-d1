+def _load_checklist(checklist_id, locale):
+    base = d1_query_one("SELECT * FROM checklists WHERE id = ? AND is_published = 1", [checklist_id])
+    if not base:
+        return None
+    tr = None
+    if locale != "en":
+        tr = d1_query_one(
+            "SELECT title, description, sections FROM checklist_translations WHERE checklist_id = ? AND locale = ?",
+            [checklist_id, locale],
+        )
+    src = tr or base
+    return {
+        "id": base["id"],
+        "title": src["title"],
+        "description": src["description"],
+        "legal_basis": base.get("legal_basis"),
+        "audience": base.get("audience"),
+        "content_version": base.get("content_version"),
+        "locale": locale if tr else "en",
+        "sections": json.loads(src["sections"]),
+    }
