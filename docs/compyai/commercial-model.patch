+    data = request.get_json() or {}
+    # Build dynamic SET clause for provided fields
+    allowed = ["name", "description", "provider", "model_type", "purpose",
+               "deployment_type", "eu_facing", "status"]
+    sets, vals = [], []
+    for field in allowed:
+        if field in data:
+            v = data[field]
+            if field == "eu_facing":
+                v = 1 if v else 0
+            sets.append(f"{field} = ?")
+            vals.append(v)
