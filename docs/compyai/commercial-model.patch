+    tier = get_tenant_tier(request.tenant_id)
+    locale = request_locale()
+    mod = get_module_content(module_id, locale)
+
+    if not mod:
+        return jsonify({"error": "Module not found"}), 404
+
+    # Check tier access
+    tier_hierarchy = {"free": 0, "starter": 1, "pro": 2, "enterprise": 3}
+    if tier_hierarchy.get(tier, 0) < tier_hierarchy.get(mod["tier_required"], 0):
+        return jsonify({"error": "Upgrade required", "tier_required": mod["tier_required"]}), 403
+
+    # Mark as in_progress if not started
+    user_id = request.tenant_user["id"]
+    existing = d1_query_one(
+        "SELECT id, status FROM training_progress WHERE user_id = ? AND module_id = ?",
+        [user_id, module_id],
+    )
+
+    if not existing:
+        d1_execute(
+            "INSERT INTO training_progress (id, user_id, tenant_id, module_id, status, started_at) "
+            "VALUES (?, ?, ?, ?, 'in_progress', datetime('now'))",
+            [str(uuid.uuid4()), user_id, request.tenant_id, module_id],
+        )
+    elif existing["status"] == "not_started":
+        d1_execute(
+            "UPDATE training_progress SET status = 'in_progress', started_at = datetime('now') WHERE id = ?",
+            [existing["id"]],
+        )
+
+    # Return content without correct answers (prevent cheating)
+    safe_content = {
+        "sections": mod["content"]["sections"],
+        "quiz": [
+            {
+                "question": q["question"],
+                "options": q["options"],
+            }
+            for q in mod["content"].get("quiz", [])
+        ],
+    }
+
+    return jsonify({
+        "id": mod["id"],
+        "title": mod["title"],
+        "description": mod["description"],
+        "category": mod["category"],
+        "duration_min": mod["duration_min"],
+        "content_version": mod.get("content_version"),
