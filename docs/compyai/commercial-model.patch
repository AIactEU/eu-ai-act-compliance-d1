+    done_map = {p["checklist_id"]: p["done"] for p in d1_query(
+        "SELECT checklist_id, COUNT(*) AS done FROM checklist_progress WHERE tenant_id = ? AND done = 1 GROUP BY checklist_id",
+        [request.tenant_id])}
+    out = []
+    for c in rows:
