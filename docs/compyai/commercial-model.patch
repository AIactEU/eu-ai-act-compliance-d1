-def classify_risk(answers: dict) -> dict:
-    """
-    Determine risk level from wizard answers.
-    Returns: {"risk_level": str, "annex_iii_category": str|None, "confidence": str, "reasoning": list}
-    """
-    reasoning = []
-    has_unacceptable = False
-    high_risk_flags = 0
-    annex_iii_cat = None
-
-    for criterion in RISK_CRITERIA:
-        cid = criterion["id"]
-        answer_value = answers.get(cid)
-        if not answer_value:
-            continue
-
-        # Find selected option
-        selected = None
-        for opt in criterion["options"]:
-            if opt["value"] == answer_value:
-                selected = opt
-                break
-
-        if not selected:
-            continue
-
-        flag = selected.get("risk_flag")
-        if flag == "unacceptable":
-            has_unacceptable = True
-            reasoning.append(f"PROHIBITED: {criterion['question']} → {selected['label']}")
-        elif flag == "high":
-            high_risk_flags += 1
-            if selected.get("annex_iii"):
-                annex_iii_cat = selected["annex_iii"]
-            reasoning.append(f"HIGH RISK: {criterion['question']} → {selected['label']}")
-        else:
-            reasoning.append(f"OK: {criterion['question']} → {selected['label']}")
-
-    # Determine final classification
-    if has_unacceptable:
-        return {
-            "risk_level": "unacceptable",
-            "annex_iii_category": None,
-            "confidence": "high",
-            "reasoning": reasoning,
-        }
-
-    if high_risk_flags >= 1:
-        # Check for the Article 6(3) exception: if the AI system does not pose
-        # a significant risk of harm, provider can self-declare as non-high-risk.
-        # We flag this but default to high-risk classification.
-        confidence = "high" if high_risk_flags >= 2 else "medium"
-        return {
-            "risk_level": "high",
-            "annex_iii_category": annex_iii_cat,
-            "confidence": confidence,
-            "reasoning": reasoning,
-        }
-
-    # Check for limited risk (transparency obligations under Article 50)
-    purpose_answer = answers.get("purpose", "")
-    limited_triggers = ["content_generation", "decision_support"]
-    if purpose_answer in limited_triggers:
-        return {
-            "risk_level": "limited",
-            "annex_iii_category": None,
-            "confidence": "medium",
-            "reasoning": reasoning + ["Article 50: transparency obligations apply for this type of system."],
-        }
-
-    return {
-        "risk_level": "minimal",
-        "annex_iii_category": None,
-        "confidence": "high",
-        "reasoning": reasoning,
-    }
-
