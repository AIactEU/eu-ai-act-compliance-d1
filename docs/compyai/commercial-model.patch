+}
+function selectOption(cid,val){wizardAnswers[cid]=val;document.querySelectorAll(`[id^="wopt_${cid}_"]`).forEach(el=>el.classList.remove('selected'));const s=document.getElementById(`wopt_${cid}_${val}`);if(s)s.classList.add('selected');}
