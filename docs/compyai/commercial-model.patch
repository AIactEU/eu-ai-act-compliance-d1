+    if not system:
+        return jsonify({"error": "System not found"}), 404
+
+    data = request.get_json() or {}
+    answers = data.get("answers", {})
+    notes = data.get("notes", "")
+
+    if not answers:
+        return jsonify({"error": "No answers provided"}), 400
+
+    # Run classification engine
+    result = classify_risk(answers)
+
+    assessment_id = str(uuid.uuid4())
+    d1_execute(
+        """INSERT INTO risk_assessments
+           (id, ai_system_id, tenant_id, criteria_answers, risk_result,
+            annex_iii_category, confidence, assessor_id, notes, completed_at)
+           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, datetime('now'))""",
+        [
+            assessment_id, sys_id, request.tenant_id,
+            json.dumps(answers), result["risk_level"],
+            result.get("annex_iii_category"), result["confidence"],
+            request.tenant_user["id"], notes,
+        ],
+    )
+
+    # Update the AI system's risk level
+    d1_execute(
+        "UPDATE ai_systems SET risk_level = ?, updated_at = datetime('now') WHERE id = ?",
+        [result["risk_level"], sys_id],
+    )
+
+    audit(request.tenant_id, request.tenant_user["id"], "risk_assessed",
+          "ai_system", sys_id, {"risk_level": result["risk_level"]})
+
+    return jsonify({
+        "assessment_id": assessment_id,
+        **result,
