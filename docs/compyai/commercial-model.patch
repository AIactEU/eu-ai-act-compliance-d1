+"""
+Comply AI — plans, packs and entitlements.
+
+Plans live in the D1 `plans` table (seeded from the eu-ai-act-compliance-d1
+repository, content/plans.json). This module caches them per process and
+resolves a tenant's effective entitlements:
+
+  - packs (one-time purchases) expire at tenants.plan_expires_at and fall
+    back to the free plan;
+  - per-seat subscriptions take the seat count stored on the tenant;
+  - the plan's `training_tier` drives module access (free/starter/pro/enterprise).
+
+Stripe price ids are read from the environment variable named in each plan's
+`stripe_price_env` column, so prices can be rotated without a deploy of content.
+"""
+
+import json
+import logging
+import os
+import time
+from datetime import datetime, timezone
+
+log = logging.getLogger(__name__)
+
+TIER_RANK = {"free": 0, "starter": 1, "pro": 2, "enterprise": 3}
+CACHE_TTL_SECONDS = 300
+
+_d1_query = None
+_cache = {"plans": None, "loaded_at": 0.0}
+
+
+def configure(d1_query_fn):
+    """Inject the D1 query function (avoids a circular import with app.py)."""
+    global _d1_query
+    _d1_query = d1_query_fn
+    _cache["plans"] = None
+
+
+def _fallback_free_plan():
+    return {
+        "id": "free", "name": "Free", "kind": "free", "position": 1, "price_eur": 0,
+        "billing": "free", "seats_included": 1, "seat_min": None, "term_months": None,
+        "training_tier": "free", "stripe_price_env": None, "tagline": "", "badge": None,
+        "cta": "Start free", "highlights": [], "is_active": True, "price_ids": [],
+        "entitlements": {
+            "ai_systems": 2, "docs_per_month": 0, "seats": 1, "certificates": False,
+            "evidence_report": False, "audit_trail": False, "checklists": [],
+            "checklists_readonly": ["chk_article4_evidence"], "deadline_feed": True,
+            "api_access": False, "priority_support": False,
+        },
+    }
+
+
+def _load():
+    if _d1_query is None:
+        raise RuntimeError("plans.configure(d1_query) must be called before use")
+    rows = _d1_query("SELECT * FROM plans ORDER BY position")
+    plans = {}
+    for r in rows:
+        r = dict(r)
+        r["highlights"] = json.loads(r.get("highlights") or "[]")
+        r["entitlements"] = json.loads(r.get("entitlements") or "{}")
+        r["is_active"] = bool(r.get("is_active", 1))
+        env_name = r.get("stripe_price_env")
+        try:
+            r["price_ids"] = [p for p in json.loads(os.environ.get(env_name, "[]")) if p] if env_name else []
+        except json.JSONDecodeError:
+            log.warning("plans: %s is not a JSON list of Stripe price ids", env_name)
+            r["price_ids"] = []
+        plans[r["id"]] = r
+    if "free" not in plans:
+        plans["free"] = _fallback_free_plan()
+    return plans
+
+
+def get_plans(force=False):
+    """All plans keyed by id (cached)."""
+    now = time.time()
+    if force or _cache["plans"] is None or now - _cache["loaded_at"] > CACHE_TTL_SECONDS:
+        try:
+            _cache["plans"] = _load()
+            _cache["loaded_at"] = now
+        except Exception as e:  # keep serving stale data rather than failing requests
+            log.error("plans: reload failed: %s", e)
+            if _cache["plans"] is None:
+                _cache["plans"] = {"free": _fallback_free_plan()}
+    return _cache["plans"]
+
+
+def get_plan(plan_id):
+    plans = get_plans()
+    return plans.get(plan_id) or plans["free"]
+
+
+def active_plans():
+    """Plans to show on the pricing page, in display order, without secrets."""
+    out = []
+    for p in sorted(get_plans().values(), key=lambda x: x["position"]):
+        if not p["is_active"]:
+            continue
+        q = {k: v for k, v in p.items() if k != "price_ids"}
+        q["purchasable"] = bool(p["price_ids"]) or p["kind"] in ("free", "enterprise")
+        out.append(q)
+    return out
+
+
+def all_price_ids():
+    ids = set()
+    for p in get_plans().values():
+        ids.update(p["price_ids"])
+    return ids
+
+
+def plan_for_price_id(price_id):
+    for p in get_plans().values():
+        if price_id in p["price_ids"]:
+            return p
+    return None
+
+
+def primary_price_id(plan_id):
+    p = get_plan(plan_id)
+    return p["price_ids"][0] if p["price_ids"] else None
+
+
+def _now_iso():
+    return datetime.now(timezone.utc).isoformat()
+
+
+def resolve_entitlements(tenant_row):
+    """
+    tenant_row: dict with plan, seats, plan_expires_at (and optionally tier, locale).
+    Returns the same shape the eu-ai-act-compliance-d1 worker returns from
+    GET /api/v1/tenants/:id/entitlements.
+    """
+    tenant_row = tenant_row or {}
+    expires_at = tenant_row.get("plan_expires_at")
+    expired = bool(expires_at) and expires_at < _now_iso()
+    purchased = tenant_row.get("plan") or _legacy_plan_from_tier(tenant_row.get("tier"))
+    effective_id = "free" if expired else purchased
+    plan = get_plan(effective_id)
+
+    ent = dict(plan["entitlements"])
+    if ent.get("seats") == "quantity":
+        ent["seats"] = tenant_row.get("seats") or plan.get("seat_min") or 1
+
+    return {
+        "tenant_id": tenant_row.get("id"),
+        "purchased_plan": purchased,
+        "effective_plan": plan["id"],
+        "plan_name": plan["name"],
+        "plan_kind": plan["kind"],
+        "expired": expired,
+        "expires_at": expires_at,
+        "training_tier": plan["training_tier"],
+        "locale": tenant_row.get("locale") or "en",
+        "entitlements": ent,
+    }
+
+
+def _legacy_plan_from_tier(tier):
+    """Map a pre-2026 `tenants.tier` value to a plan id."""
+    return {"starter": "legacy_starter", "pro": "legacy_pro", "enterprise": "enterprise"}.get(tier or "free", "free")
+
+
+def training_tier_for(tenant_row):
+    return resolve_entitlements(tenant_row)["training_tier"]
+
+
+def has_feature(tenant_row, feature):
+    """feature: certificates | evidence_report | audit_trail | api_access | priority_support"""
+    return bool(resolve_entitlements(tenant_row)["entitlements"].get(feature))
+
+
+def checklist_access(tenant_row, checklist_id):
+    """Returns 'edit', 'readonly' or None."""
+    ent = resolve_entitlements(tenant_row)["entitlements"]
+    if checklist_id in ent.get("checklists", []):
+        return "edit"
+    if checklist_id in ent.get("checklists_readonly", []):
+        return "readonly"
+    return None
+
+
+def limit_for(tenant_row, resource):
+    """resource: ai_systems | docs_per_month | seats. None means unlimited."""
+    return resolve_entitlements(tenant_row)["entitlements"].get(resource)
