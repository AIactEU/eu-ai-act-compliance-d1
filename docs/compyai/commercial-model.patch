-def get_subscription_tier_from_stripe(customer_id):
-    """Determine Comply AI subscription tier. Ignores non-Comply AI products."""
-    sub = _find_complyai_subscription(customer_id)
-    if not sub or sub["status"] not in ("active", "trialing"):
-        return "free"
-
-    try:
-        price_id = sub["items"]["data"][0]["price"]["id"]
-        for tier_name, cfg in TIERS.items():
-            if tier_name == "free":
-                continue
-            if price_id in cfg.get("price_ids", []):
-                return tier_name
-        return "free"
-    except (KeyError, IndexError):
-        return "free"
