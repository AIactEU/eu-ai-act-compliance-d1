-def d1_execute(sql, params=None):
-    """Execute SQL against Cloudflare D1 via REST API."""
-    resp = requests.post(
-        f"{D1_BASE}/query",
-        headers={
-            "Authorization": f"Bearer {D1_API_TOKEN}",
-            "Content-Type": "application/json",
-        },
-        json={"sql": sql, "params": params or []},
-        timeout=10,
-    )
-    data = resp.json()
-    if not data.get("success"):
-        log.error(f"D1 error: {data}")
-        raise RuntimeError(f"D1 query failed: {data.get('errors')}")
-    results = data.get("result", [])
-    return results[0] if results else {"results": [], "meta": {}}
-
-
-def d1_query(sql, params=None):
-    """Query D1, return list of row dicts."""
-    result = d1_execute(sql, params)
-    return result.get("results", [])
-
-
-def d1_query_one(sql, params=None):
-    """Query D1, return single row dict or None."""
-    rows = d1_query(sql, params)
-    return rows[0] if rows else None
