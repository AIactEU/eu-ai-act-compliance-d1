+@app.route("/api/audit", methods=["GET"])
+@require_tenant
+def get_audit_log():
+    """Get audit trail with filtering and pagination."""
+    # Check tier — audit trail is Pro+ feature
+    if not plans.has_feature(get_tenant_row(request.tenant_id), "audit_trail"):
+        return jsonify({"error": "The audit trail requires a Team, Business or pack plan", "upgrade": True}), 403
+
+    page = int(request.args.get("page", 1))
+    per_page = min(int(request.args.get("per_page", 50)), 100)
+    action_filter = request.args.get("action")
+    entity_filter = request.args.get("entity_type")
+    user_filter = request.args.get("user_id")
+    date_from = request.args.get("from")
+    date_to = request.args.get("to")
+
+    where = ["a.tenant_id = ?"]
+    params = [request.tenant_id]
+
+    if action_filter:
+        where.append("a.action = ?")
+        params.append(action_filter)
+    if entity_filter:
+        where.append("a.entity_type = ?")
+        params.append(entity_filter)
+    if user_filter:
+        where.append("a.user_id = ?")
+        params.append(user_filter)
+    if date_from:
+        where.append("a.created_at >= ?")
+        params.append(date_from)
+    if date_to:
+        where.append("a.created_at <= ?")
+        params.append(date_to)
+
+    where_clause = " AND ".join(where)
+
+    # Count total
+    count_row = d1_query_one(
+        f"SELECT COUNT(*) as cnt FROM audit_log a WHERE {where_clause}", params
+    )
+    total = (count_row or {}).get("cnt", 0)
+
+    # Fetch page
+    offset = (page - 1) * per_page
+    rows = d1_query(
+        f"""SELECT a.*, u.name as user_name, u.email as user_email
+            FROM audit_log a
+            LEFT JOIN users u ON a.user_id = u.id
+            WHERE {where_clause}
+            ORDER BY a.created_at DESC
+            LIMIT ? OFFSET ?""",
+        params + [per_page, offset],
+    )
+
+    # Parse JSON details
+    for row in rows:
+        if row.get("details"):
+            try:
+                row["details"] = json.loads(row["details"])
+            except (json.JSONDecodeError, TypeError):
+                pass
+
+    return jsonify({
+        "entries": rows,
+        "pagination": {
+            "page": page,
+            "per_page": per_page,
+            "total": total,
+            "total_pages": (total + per_page - 1) // per_page,
+        },
+    })
+
