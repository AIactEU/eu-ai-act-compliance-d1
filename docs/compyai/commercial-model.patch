+@app.route("/api/webhooks/stripe", methods=["POST"])
+def stripe_webhook():
+    """Handle Stripe webhook events — only process Comply AI subscriptions."""
+    payload = request.get_data()
+    sig = request.headers.get("Stripe-Signature")
+    try:
+        event = stripe.Webhook.construct_event(payload, sig, STRIPE_WEBHOOK_SECRET)
+    except Exception:
+        return jsonify({"error": "Invalid webhook"}), 400
+
+    etype = event["type"]
+    obj = event["data"]["object"]
+
+    # One-time packs and new subscriptions arrive here first.
+    if etype == "checkout.session.completed":
+        meta = obj.get("metadata") or {}
+        tenant_id = meta.get("tenant_id") or obj.get("client_reference_id")
+        plan = plans.get_plans().get(meta.get("plan_id") or "")
+        if not tenant_id or not plan:
+            log.info("Webhook: checkout.session.completed without Comply AI metadata, ignoring")
+            return jsonify({"status": "ignored"}), 200
+
+        if obj.get("mode") == "payment" and plan["kind"] == "pack":
+            if obj.get("payment_status") not in ("paid", "no_payment_required"):
+                return jsonify({"status": "pending"}), 200
+            expires = _add_months(datetime.now(timezone.utc), plan["term_months"]).isoformat()
+            _apply_plan_to_tenant(tenant_id, plan["id"], seats=plan.get("seats_included"),
+                                  expires_at=expires, customer_id=obj.get("customer"))
+        elif obj.get("mode") == "subscription":
+            # The subscription event carries the authoritative seat count; record the plan now so the UI updates.
+            _apply_plan_to_tenant(tenant_id, plan["id"],
+                                  seats=plan.get("seats_included") or plan.get("seat_min"),
+                                  expires_at=None, customer_id=obj.get("customer"),
+                                  subscription_id=obj.get("subscription"))
+        return jsonify({"status": "ok"}), 200
+
+    if etype in ("customer.subscription.created", "customer.subscription.updated",
+                 "customer.subscription.deleted"):
+        sub = obj
+        item, plan = None, None
+        for it in sub.get("items", {}).get("data", []):
+            plan = plans.plan_for_price_id(it.get("price", {}).get("id"))
+            if plan:
+                item = it
+                break
+        if not item:
+            # Not our product (could be another product on the same Stripe account)
+            log.info(f"Webhook: ignoring non-Comply AI subscription event {etype}")
+            return jsonify({"status": "ignored"}), 200
+
+        tenant_id = (sub.get("metadata") or {}).get("tenant_id") or _tenant_for_customer(sub["customer"])
+        if not tenant_id:
+            log.warning(f"Webhook: no tenant for customer {sub['customer']}")
+            return jsonify({"status": "no_tenant"}), 200
+
+        ended = etype == "customer.subscription.deleted" or sub.get("status") not in ("active", "trialing", "past_due")
+        if ended:
+            row = get_tenant_row(tenant_id)
+            current = plans.get_plan(row.get("plan"))
+            if current["kind"] == "pack" and not plans.resolve_entitlements(row)["expired"]:
+                # Keep an unexpired pack; just drop the subscription reference.
+                d1_execute("UPDATE tenants SET stripe_subscription = NULL, updated_at = datetime('now') WHERE id = ?",
+                           [tenant_id])
+            else:
+                _apply_plan_to_tenant(tenant_id, "free", seats=1, expires_at=None,
+                                      customer_id=sub["customer"], subscription_id=None)
+        else:
+            seats = item.get("quantity") if plan["billing"] == "per_seat_monthly" else plan.get("seats_included")
+            _apply_plan_to_tenant(tenant_id, plan["id"], seats=seats, expires_at=None,
+                                  customer_id=sub["customer"], subscription_id=sub["id"])
+
+    return jsonify({"status": "ok"}), 200
+
