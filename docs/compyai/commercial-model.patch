+        return jsonify({"error": "Module not found"}), 404
+
+    # Grade the quiz
+    result = grade_quiz(module_id, answers, request_locale())
+    if "error" in result:
+        return jsonify(result), 400
+
+    user_id = request.tenant_user["id"]
+    score = result["score"]
+    passed = result["passed"]
+    status = "completed" if passed else "in_progress"
+
+    # Update or insert progress
+    existing = d1_query_one(
+        "SELECT id FROM training_progress WHERE user_id = ? AND module_id = ?",
+        [user_id, module_id],
+    )
+
+    if existing:
+        d1_execute(
+            "UPDATE training_progress SET status = ?, score = ?, completed_at = ? WHERE id = ?",
+            [status, score, datetime.now(timezone.utc).isoformat() if passed else None, existing["id"]],
+        )
+    else:
+        d1_execute(
+            "INSERT INTO training_progress (id, user_id, tenant_id, module_id, status, score, started_at, completed_at) "
+            "VALUES (?, ?, ?, ?, ?, ?, datetime('now'), ?)",
+            [str(uuid.uuid4()), user_id, request.tenant_id, module_id,
+             status, score, datetime.now(timezone.utc).isoformat() if passed else None],
+        )
+
+    if passed:
+        audit(request.tenant_id, user_id, "training_completed",
+              "training", module_id, {"score": score, "module": mod["title"]})
+
+    return jsonify({
+        **result,
+        "status": status,
+        "message": "Congratulations! Module completed." if passed else f"Score {score}% — you need 70% to pass. Please review and try again.",
+    })
