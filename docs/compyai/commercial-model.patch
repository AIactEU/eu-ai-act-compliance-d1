+@app.route("/api/compliance/posture", methods=["GET"])
+@require_tenant
+def get_compliance_posture():
+    """
+    Calculate and return a comprehensive compliance posture summary.
+    Used for the compliance dashboard and the exported report.
+    """
+    tid = request.tenant_id
+    tier = get_tenant_tier(tid)
+
+    # ── Systems overview ──
+    systems = d1_query(
+        "SELECT * FROM ai_systems WHERE tenant_id = ? AND status = 'active'",
+        [tid],
+    )
+    total_systems = len(systems)
+    risk_counts = {}
+    for s in systems:
+        rl = s.get("risk_level", "unclassified")
+        risk_counts[rl] = risk_counts.get(rl, 0) + 1
+
+    unclassified = risk_counts.get("unclassified", 0)
+    high_risk = risk_counts.get("high", 0)
+    systems_assessed = total_systems - unclassified
+
+    # ── Documentation coverage ──
+    # For high-risk systems, check if documentation exists
+    high_risk_systems = [s for s in systems if s.get("risk_level") == "high"]
+    documented_high_risk = 0
+    if high_risk_systems:
+        for hrs in high_risk_systems:
+            doc = d1_query_one(
+                "SELECT id FROM documents WHERE ai_system_id = ? AND tenant_id = ?",
+                [hrs["id"], tid],
+            )
+            if doc:
+                documented_high_risk += 1
+
+    doc_coverage = round((documented_high_risk / len(high_risk_systems)) * 100) if high_risk_systems else 100
+
+    # ── Training progress ──
+    users = d1_query("SELECT id FROM users WHERE tenant_id = ?", [tid])
+    all_modules = get_modules_for_tier(tier)
+    available_modules = [m for m in all_modules if not m["locked"]]
+    total_possible = len(users) * len(available_modules) if available_modules else 0
+
+    completed_training = 0
+    if total_possible:
+        ct_row = d1_query_one(
+            "SELECT COUNT(*) as cnt FROM training_progress WHERE tenant_id = ? AND status = 'completed'",
+            [tid],
+        )
+        completed_training = (ct_row or {}).get("cnt", 0)
+
+    training_percent = round((completed_training / total_possible) * 100) if total_possible else 0
+
+    # ── Overall compliance score ──
+    # Weighted average: inventory 20%, risk assessment 25%, documentation 30%, training 25%
+    inventory_score = 100 if total_systems > 0 else 0
+    assessment_score = round((systems_assessed / total_systems) * 100) if total_systems else 0
+    doc_score = doc_coverage
+    training_score = training_percent
+
+    overall = round(
+        inventory_score * 0.20 +
+        assessment_score * 0.25 +
+        doc_score * 0.30 +
+        training_score * 0.25
+    )
+
+    # ── Action items ──
+    actions = []
+    if total_systems == 0:
+        actions.append({"priority": "high", "text": "Register your AI systems in the inventory", "category": "inventory"})
+    if unclassified > 0:
+        actions.append({"priority": "high", "text": f"Classify risk for {unclassified} unassessed system(s)", "category": "assessment"})
+    if high_risk > 0 and documented_high_risk < len(high_risk_systems):
+        undocumented = len(high_risk_systems) - documented_high_risk
+        actions.append({"priority": "high", "text": f"Generate Annex IV documentation for {undocumented} high-risk system(s)", "category": "documentation"})
+    if training_percent < 100:
+        actions.append({"priority": "medium", "text": f"Complete AI literacy training ({training_percent}% done)", "category": "training"})
+    if risk_counts.get("unacceptable", 0) > 0:
+        actions.append({"priority": "critical", "text": "URGENT: Discontinue prohibited AI system(s) immediately", "category": "prohibited"})
+
+    # ── Timeline compliance ──
+    from datetime import date
+    today = date.today()
+    deadlines = [
+        {"date": "2025-02-02", "label": "Prohibited practices & AI literacy", "status": "active" if today >= date(2025, 2, 2) else "upcoming"},
+        {"date": "2025-08-02", "label": "GPAI model obligations", "status": "active" if today >= date(2025, 8, 2) else "upcoming"},
+        {"date": "2026-08-02", "label": "Full high-risk system requirements", "status": "active" if today >= date(2026, 8, 2) else "upcoming"},
+        {"date": "2027-08-02", "label": "High-risk AI in regulated products", "status": "active" if today >= date(2027, 8, 2) else "upcoming"},
+    ]
+
+    return jsonify({
+        "overall_score": overall,
+        "breakdown": {
+            "inventory": {"score": inventory_score, "total_systems": total_systems},
+            "assessment": {"score": assessment_score, "assessed": systems_assessed, "unclassified": unclassified},
+            "documentation": {"score": doc_score, "high_risk_total": len(high_risk_systems), "documented": documented_high_risk},
+            "training": {"score": training_score, "completed": completed_training, "total_required": total_possible},
+        },
+        "risk_distribution": risk_counts,
+        "systems": [
+            {"id": s["id"], "name": s["name"], "risk_level": s.get("risk_level", "unclassified"),
+             "provider": s.get("provider"), "status": s.get("status")}
+            for s in systems
+        ],
+        "action_items": sorted(actions, key=lambda a: {"critical": 0, "high": 1, "medium": 2, "low": 3}.get(a["priority"], 4)),
+        "deadlines": deadlines,
+        "team_size": len(users),
+        "tier": tier,
+    })
+
