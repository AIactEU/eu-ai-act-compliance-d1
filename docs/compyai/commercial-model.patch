+function openAssess(sysId,sysName){assessingSystemId=sysId;wizardStep=0;wizardAnswers={};document.getElementById('assessSystemName').textContent='Assessing: '+sysName;document.getElementById('wizardResult').style.display='none';document.getElementById('wizardNav').style.display='flex';buildWizard();openModal('assessModal');}
