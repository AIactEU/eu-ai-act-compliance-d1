-def get_tenant_tier(tenant_id):
-    row = d1_query_one("SELECT tier FROM tenants WHERE id = ?", [tenant_id])
-    return (row or {}).get("tier", "free")
-
-
-def check_tier_limit(tenant_id, resource, count=1):
-    """Check if tenant can add `count` more of `resource`."""
-    tier_name = get_tenant_tier(tenant_id)
-    tier = TIERS.get(tier_name, TIERS["free"])
-    limit = tier.get(resource)
-    if limit is None:  # unlimited
-        return True, None
-
-    # Count current usage
-    if resource == "systems":
-        row = d1_query_one(
-            "SELECT COUNT(*) as cnt FROM ai_systems WHERE tenant_id = ? AND status != 'retired'",
-            [tenant_id],
-        )
-    elif resource == "docs":
-        month_start = datetime.now(timezone.utc).replace(day=1, hour=0, minute=0, second=0).isoformat()
-        row = d1_query_one(
-            "SELECT COUNT(*) as cnt FROM documents WHERE tenant_id = ? AND created_at >= ?",
-            [tenant_id, month_start],
-        )
-    elif resource == "members":
-        row = d1_query_one(
-            "SELECT COUNT(*) as cnt FROM users WHERE tenant_id = ?",
-            [tenant_id],
-        )
-    else:
-        return True, None
-
-    current = (row or {}).get("cnt", 0)
-    if current + count > limit:
-        return False, {
-            "error": f"{resource} limit reached",
-            "current": current,
-            "limit": limit,
-            "tier": tier_name,
-            "message": f"Upgrade to add more {resource}.",
-        }
-    return True, None
-
-
-def audit(tenant_id, user_id, action, entity_type=None, entity_id=None, details=None):
