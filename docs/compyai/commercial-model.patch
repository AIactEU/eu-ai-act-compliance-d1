+def find_or_create_customer(user_id, email):
+    customers = stripe.Customer.search(query=f"metadata['auth0_user_id']:'{user_id}'")
+    if customers.data:
+        return customers.data[0].id
+    if email:
+        customers = stripe.Customer.search(query=f"email:'{email}'")
+        if customers.data:
+            c = customers.data[0]
+            stripe.Customer.modify(c.id, metadata={"auth0_user_id": user_id})
+            return c.id
+    c = stripe.Customer.create(email=email, metadata={"auth0_user_id": user_id})
+    return c.id
+
+
+
+def get_subscription_plan_from_stripe(customer_id):
+    """Return (plan_id, seats) for the active Comply AI subscription, or ("free", None)."""
+    sub = _find_complyai_subscription(customer_id)
+    if not sub or sub["status"] not in ("active", "trialing"):
+        return "free", None
+    try:
+        item = sub["items"]["data"][0]
+        plan = plans.plan_for_price_id(item["price"]["id"])
+        if not plan:
+            return "free", None
+        seats = item.get("quantity") if plan["billing"] == "per_seat_monthly" else plan.get("seats_included")
+        return plan["id"], seats
+    except (KeyError, IndexError):
+        return "free", None
+
+
+def _add_months(dt, months):
+    month = dt.month - 1 + months
+    year = dt.year + month // 12
+    month = month % 12 + 1
+    leap = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
+    days = [31, 29 if leap else 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][month - 1]
+    return dt.replace(year=year, month=month, day=min(dt.day, days))
+
+
+def _apply_plan_to_tenant(tenant_id, plan_id, seats=None, expires_at=None, customer_id=None, subscription_id=None):
+    """Persist a plan change on the tenant. `tier` mirrors the plan's training tier."""
+    plan = plans.get_plan(plan_id)
+    d1_execute(
+        "UPDATE tenants SET plan = ?, seats = ?, plan_expires_at = ?, tier = ?, "
+        "stripe_customer = COALESCE(?, stripe_customer), stripe_subscription = ?, updated_at = datetime('now') "
+        "WHERE id = ?",
+        [plan["id"], seats, expires_at, plan["training_tier"], customer_id, subscription_id, tenant_id],
+    )
+    audit(tenant_id, "stripe", "plan_changed", "plan", plan["id"], {"seats": seats, "expires_at": expires_at})
+    log.info(f"Comply AI: tenant {tenant_id} -> plan {plan['id']} seats={seats} expires={expires_at}")
+
+
+def _tenant_for_customer(customer_id):
+    try:
+        customer = stripe.Customer.retrieve(customer_id)
+    except Exception as e:
+        log.error(f"Stripe customer lookup failed: {e}")
+        return None
+    auth0_id = (customer.metadata or {}).get("auth0_user_id")
+    if not auth0_id:
+        return None
+    row = d1_query_one("SELECT tenant_id FROM users WHERE auth0_sub = ?", [auth0_id])
+    return row["tenant_id"] if row else None
