+function showDocSection(){docSections.forEach((_,i)=>{document.getElementById('dsec'+i).classList.toggle('active',i===docCurrentSection);const d=document.getElementById('ddot'+i);d.classList.toggle('done',i<docCurrentSection);d.classList.toggle('current',i===docCurrentSection);});document.getElementById('docPrev').style.visibility=docCurrentSection===0?'hidden':'visible';document.getElementById('docSectionCounter').textContent=`Section ${docCurrentSection+1} of ${docSections.length}`;document.getElementById('docNext').textContent=docCurrentSection===docSections.length-1?'✓ Generate Document':'Next Section →';}
