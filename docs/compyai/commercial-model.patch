+def normalise_locale(locale):
+    loc = (locale or "en").lower()[:2]
+    return loc if loc in SUPPORTED_LOCALES else "en"
+
+
+def _load():
+    if _d1_query is None:
+        raise RuntimeError("training.configure(d1_query) must be called before use")
+    rows = _d1_query(
+        "SELECT id, title, description, category, tier_required, duration_min, order_index, "
+        "content_version, regulatory_basis, content FROM training_modules "
+        "WHERE is_published = 1 ORDER BY order_index"
+    )
+    modules = []
+    for r in rows:
+        r = dict(r)
+        r["content"] = json.loads(r["content"])
+        r["regulatory_basis"] = json.loads(r.get("regulatory_basis") or "[]")
+        modules.append(r)
+
+    trows = _d1_query(
+        "SELECT module_id, locale, title, description, content FROM training_module_translations"
+    )
+    translations = {}
+    for t in trows:
+        translations[(t["module_id"], t["locale"])] = {
+            "title": t["title"],
+            "description": t["description"],
+            "content": json.loads(t["content"]),
+        }
+    return modules, translations
+
+
+def _modules():
+    now = time.time()
+    if _cache["modules"] is None or now - _cache["loaded_at"] > CACHE_TTL_SECONDS:
+        try:
