+def _find_complyai_subscription(customer_id):
+    """
+    Find the active Comply AI subscription for a customer.
+    Ignores subscriptions for other products (e.g. vibeCAD).
+    Returns the subscription object or None.
+    """
+    complyai_prices = _get_complyai_price_ids()
+    if not complyai_prices:
+        return None
+
+    try:
+        subs = stripe.Subscription.list(
+            customer=customer_id,
+            status="all",
+            limit=10,  # A customer unlikely has more than 10 subs
+        )
+
+        for sub in subs.data:
+            # Check each subscription item's price
+            for item in sub.get("items", {}).get("data", []):
+                price_id = item.get("price", {}).get("id")
+                if price_id in complyai_prices:
+                    return sub
+
+        return None
+    except Exception as e:
+        log.error(f"Error finding Comply AI subscription: {e}")
+        return None
+
