+        row = d1_query_one(
+            "SELECT COUNT(*) as cnt FROM users WHERE tenant_id = ?",
+            [tenant_id],
+        )
+    else:
+        return True, None
+
+    current = (row or {}).get("cnt", 0)
+    if current + count > limit:
+        return False, {
+            "error": f"{resource} limit reached",
+            "current": current,
+            "limit": limit,
+            "plan": ent["effective_plan"],
+            "tier": ent["training_tier"],
+            "message": f"Upgrade your plan, add seats, or buy a pack to add more {resource}.",
+        }
+    return True, None
+
