+@app.route("/api/training/progress", methods=["GET"])
+@require_tenant
+def get_training_progress():
+    """Get training progress overview for the tenant."""
+    # Get all users in tenant
+    users = d1_query(
+        "SELECT id, name, email FROM users WHERE tenant_id = ?",
+        [request.tenant_id],
+    )
+
+    tier = get_tenant_tier(request.tenant_id)
+    all_modules = get_modules_for_tier(tier)
+    available_count = sum(1 for m in all_modules if not m["locked"])
+
+    # Get all progress records for tenant
+    all_progress = d1_query(
+        "SELECT user_id, module_id, status, score, completed_at FROM training_progress WHERE tenant_id = ?",
+        [request.tenant_id],
+    )
+
+    # Build per-user summary
+    user_summaries = []
+    for user in users:
+        user_progress = [p for p in all_progress if p["user_id"] == user["id"]]
+        completed = sum(1 for p in user_progress if p["status"] == "completed")
+        in_progress = sum(1 for p in user_progress if p["status"] == "in_progress")
+        avg_score = 0
+        scores = [p["score"] for p in user_progress if p["score"] is not None]
+        if scores:
+            avg_score = round(sum(scores) / len(scores))
+
+        user_summaries.append({
+            "user_id": user["id"],
+            "name": user["name"] or user["email"],
+            "email": user["email"],
+            "completed": completed,
+            "in_progress": in_progress,
+            "not_started": available_count - completed - in_progress,
+            "avg_score": avg_score,
+            "completion_percent": round((completed / available_count) * 100) if available_count else 0,
+        })
+
+    # Tenant-wide stats
+    total_completions = sum(u["completed"] for u in user_summaries)
+    total_possible = len(users) * available_count if available_count else 0
+
+    return jsonify({
+        "users": user_summaries,
+        "tenant_stats": {
+            "total_users": len(users),
+            "available_modules": available_count,
+            "total_completions": total_completions,
+            "total_possible": total_possible,
+            "completion_percent": round((total_completions / total_possible) * 100) if total_possible else 0,
+        },
+    })
