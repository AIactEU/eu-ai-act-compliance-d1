+@app.route("/api/systems/<sys_id>/generate-doc", methods=["POST"])
+@require_tenant
+def generate_document(sys_id):
+    """
+    Generate an Annex IV document. Accepts field values from the frontend form,
+    renders HTML, stores in R2, and creates a document record in D1.
+    """
+    # Check tier limit
+    ok, err = check_tier_limit(request.tenant_id, "docs")
+    if not ok:
+        return jsonify(err), 403
+
+    system = d1_query_one(
+        "SELECT * FROM ai_systems WHERE id = ? AND tenant_id = ?",
+        [sys_id, request.tenant_id],
+    )
+    if not system:
+        return jsonify({"error": "System not found"}), 404
+
+    data = request.get_json() or {}
+    field_values = data.get("field_values", {})
+    doc_title = data.get("title", f"Annex IV — {system['name']}")
+
+    if not field_values:
+        return jsonify({"error": "No field values provided"}), 400
+
+    # Get tenant name
+    tenant = d1_query_one("SELECT name FROM tenants WHERE id = ?", [request.tenant_id])
+    tenant_name = (tenant or {}).get("name", "")
+
+    # Get assessment for auto-fill
+    assessment = d1_query_one(
+        "SELECT * FROM risk_assessments WHERE ai_system_id = ? AND tenant_id = ? "
+        "ORDER BY created_at DESC LIMIT 1",
+        [sys_id, request.tenant_id],
+    )
+
+    # Render HTML document
+    template = get_document_template()
+    filled = auto_fill_from_system(template, system, assessment)
+    html_content = render_document_html(filled, field_values, system, tenant_name)
+
+    # Store in R2
+    doc_id = str(uuid.uuid4())
+    r2_key = f"docs/{request.tenant_id}/{doc_id}.html"
+
+    if s3:
+        try:
+            s3.put_object(
+                Bucket=R2_BUCKET,
+                Key=r2_key,
+                Body=html_content.encode("utf-8"),
+                ContentType="text/html",
+                CacheControl="private, max-age=86400",
+            )
+        except Exception as e:
+            log.error(f"R2 upload failed: {e}")
+            return jsonify({"error": "Failed to store document"}), 500
+    else:
+        return jsonify({"error": "Storage not configured"}), 500
+
+    # Also store field values as JSON for future editing
+    values_key = f"docs/{request.tenant_id}/{doc_id}_values.json"
+    try:
+        s3.put_object(
+            Bucket=R2_BUCKET,
+            Key=values_key,
+            Body=json.dumps(field_values).encode("utf-8"),
+            ContentType="application/json",
+        )
+    except Exception as e:
+        log.warning(f"Failed to store field values: {e}")
+
+    # Create document record in D1
+    d1_execute(
+        """INSERT INTO documents
+           (id, ai_system_id, tenant_id, doc_type, title, status, r2_key, version, generated_by)
+           VALUES (?, ?, ?, 'annex_iv', ?, 'draft', ?, 1, ?)""",
+        [doc_id, sys_id, request.tenant_id, doc_title, r2_key, request.tenant_user["id"]],
+    )
+
+    audit(request.tenant_id, request.tenant_user["id"], "doc_generated",
+          "document", doc_id, {"system": system["name"], "doc_type": "annex_iv"})
+
+    return jsonify({
+        "id": doc_id,
+        "title": doc_title,
+        "r2_key": r2_key,
+        "message": "Document generated successfully",
+    }), 201
+
