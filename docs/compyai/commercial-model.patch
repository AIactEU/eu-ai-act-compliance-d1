+@app.route("/api/billing/checkout", methods=["POST"])
+@require_tenant
+def billing_checkout():
+    """Create a Stripe Checkout Session for a subscription plan or a one-time pack."""
+    if request.tenant_user.get("role") != "admin":
+        return jsonify({"error": "Admin access required"}), 403
+
+    data = request.get_json() or {}
+    plan = plans.get_plans().get(data.get("plan_id") or "")
+    if not plan or not plan["is_active"] or plan["kind"] not in ("subscription", "pack"):
+        return jsonify({"error": "Unknown or non-purchasable plan"}), 400
+    price_id = plans.primary_price_id(plan["id"])
+    if not price_id:
+        return jsonify({"error": f"No Stripe price configured for {plan['id']} ({plan.get('stripe_price_env')})"}), 503
+
+    info = get_user_info()
+    cid = find_or_create_customer(info["user_id"], info["email"])
+    origin = request.headers.get("Origin") or request.host_url.rstrip("/")
+
+    line_item = {"price": price_id, "quantity": 1}
+    if plan["billing"] == "per_seat_monthly":
+        seat_min = plan.get("seat_min") or 1
+        try:
+            seats = int(data.get("seats") or seat_min)
+        except (TypeError, ValueError):
+            seats = seat_min
+        line_item["quantity"] = max(seats, seat_min)
+        line_item["adjustable_quantity"] = {"enabled": True, "minimum": seat_min, "maximum": 500}
+
+    mode = "subscription" if plan["kind"] == "subscription" else "payment"
+    params = dict(
+        mode=mode,
+        customer=cid,
+        line_items=[line_item],
+        client_reference_id=request.tenant_id,
+        metadata={"tenant_id": request.tenant_id, "plan_id": plan["id"]},
+        success_url=f"{origin}/dashboard?checkout=success#subscription",
+        cancel_url=f"{origin}/dashboard?checkout=cancelled#subscription",
+        allow_promotion_codes=True,
+    )
+    if STRIPE_AUTOMATIC_TAX:
+        params["automatic_tax"] = {"enabled": True}
+        params["tax_id_collection"] = {"enabled": True}
+    if mode == "subscription":
+        params["subscription_data"] = {"metadata": {"tenant_id": request.tenant_id, "plan_id": plan["id"]}}
+    else:
+        params["invoice_creation"] = {"enabled": True}
+
+    try:
+        cs = stripe.checkout.Session.create(**params)
+    except Exception as e:
+        log.error(f"Checkout session failed: {e}")
+        return jsonify({"error": "Could not start checkout"}), 502
+
+    audit(request.tenant_id, request.tenant_user["id"], "checkout_started", "plan", plan["id"],
+          {"mode": mode, "seats": line_item["quantity"]})
+    return jsonify({"url": cs.url, "id": cs.id})
+
