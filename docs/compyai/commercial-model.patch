+function wizardNext(){const c=wizardCriteria[wizardStep];if(!wizardAnswers[c.id]){alert('Please select an option.');return;}if(wizardStep<wizardCriteria.length-1){wizardStep++;showWizardStep();}else submitAssessment();}
+function wizardPrev(){if(wizardStep>0){wizardStep--;showWizardStep();}}
+async function submitAssessment(){
+  try{document.getElementById('wizNext').disabled=true;document.getElementById('wizNext').textContent='Classifying…';
+  const r=await fetch(`/api/systems/${assessingSystemId}/assess`,{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({answers:wizardAnswers})});const data=await r.json();
+  document.getElementById('wizardNav').style.display='none';const rd=document.getElementById('wizardResult');rd.style.display='block';
+  const level=data.risk_level;const labels={unacceptable:'🚫 Prohibited',high:'⚠️ High Risk',limited:'ℹ️ Limited Risk',minimal:'✅ Minimal Risk'};
+  const descs={unacceptable:'This AI system is PROHIBITED under Article 5 and must be discontinued immediately.',high:'HIGH RISK — full compliance with Chapter 2 requirements is mandatory.',limited:'LIMITED RISK — transparency obligations under Article 50 apply.',minimal:'MINIMAL RISK — no specific obligations, voluntary codes encouraged.'};
