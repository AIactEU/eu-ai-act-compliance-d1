+let billingPlans=[];
+function planPrice(p){
+  if(p.kind==='free')return'<div style="font-size:2rem;font-weight:800;color:#0052cc">€0</div><div style="color:#718096;font-size:.85rem;margin-bottom:1rem">forever</div>';
+  if(p.kind==='enterprise')return'<div style="font-size:2rem;font-weight:800;color:#0052cc">Custom</div><div style="color:#718096;font-size:.85rem;margin-bottom:1rem">talk to us</div>';
+  if(p.billing==='per_seat_monthly')return`<div style="font-size:2rem;font-weight:800;color:#0052cc">€${p.price_eur}<span style="font-size:.9rem;font-weight:600;color:#718096"> / seat / month</span></div><div style="color:#718096;font-size:.85rem;margin-bottom:1rem">minimum ${p.seat_min} seats (€${p.price_eur*p.seat_min}/month)</div>`;
+  if(p.billing==='one_time')return`<div style="font-size:2rem;font-weight:800;color:#0052cc">€${p.price_eur}</div><div style="color:#718096;font-size:.85rem;margin-bottom:1rem">one payment · ${p.term_months} months access</div>`;
+  return`<div style="font-size:2rem;font-weight:800;color:#0052cc">€${p.price_eur}</div><div style="color:#718096;font-size:.85rem;margin-bottom:1rem">per month · ${p.seats_included} seats included</div>`;
+}
+function planCard(p,current){
+  const isCurrent=current&&current.effective_plan===p.id&&!current.expired;
+  const popular=p.badge==='Most popular';
+  const seatInput=p.billing==='per_seat_monthly'?`<div style="display:flex;align-items:center;justify-content:center;gap:.5rem;margin-bottom:.6rem;font-size:.85rem">Seats <input type="number" id="seats_${p.id}" min="${p.seat_min}" value="${Math.max(p.seat_min,(current&&current.entitlements&&current.entitlements.seats)||p.seat_min)}" style="width:70px;padding:.3rem;border:1px solid #e2e8f0;border-radius:5px"></div>`:'';
+  let action;
+  if(isCurrent)action='<div class="btn btn-outline" style="width:100%;justify-content:center;opacity:.7">Current plan</div>';
+  else if(p.kind==='free')action='';
+  else if(p.kind==='enterprise')action='<a href="mailto:support@complyai.eu?subject=Enterprise%20Plan%20Inquiry" class="btn btn-outline" style="width:100%;justify-content:center;text-decoration:none">Contact us</a>';
+  else if(!p.purchasable)action='<div class="btn btn-outline" style="width:100%;justify-content:center;opacity:.6" title="Stripe price not configured">Coming soon</div>';
+  else action=`<button class="btn ${popular?'btn-primary':'btn-outline'}" style="width:100%;justify-content:center" onclick="checkout('${p.id}')">${esc(p.cta||'Choose')}</button>`;
+  return`<div style="border:${popular?'2px solid #0052cc':'1px solid #e2e8f0'};border-radius:12px;padding:1.5rem;text-align:center;position:relative;${popular?'box-shadow:0 4px 20px rgba(0,82,204,.12)':''}">
+    ${p.badge?`<div style="position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:${popular?'#0052cc':'#2f855a'};color:#fff;padding:2px 14px;border-radius:12px;font-size:.73rem;font-weight:600;white-space:nowrap">${esc(p.badge)}</div>`:''}
+    <div style="font-size:1.1rem;font-weight:700;margin-bottom:.35rem">${esc(p.name)}</div>
+    ${planPrice(p)}
+    <div style="font-size:.82rem;color:#4a5568;margin-bottom:.9rem;min-height:2.4em">${esc(p.tagline||'')}</div>
+    <div style="text-align:left;font-size:.83rem;color:#4a5568;margin-bottom:1.1rem;line-height:1.65">${(p.highlights||[]).map(h=>'<div>✓ '+esc(h)+'</div>').join('')}</div>
+    ${seatInput}${action}</div>`;
+}
+async function loadSubscription(){
+  try{
+    const r = await(await fetch('/api/subscription/status',{credentials:'include'})).json();
+    document.getElementById('subStatusLoading').style.display = 'none';
+    const content = document.getElementById('subStatusContent');
+    content.style.display = 'block';
+    const plan = r.plan || {};
+    const ent = plan.entitlements || {};
+    const seats = ent.seats === null ? 'unlimited' : ent.seats;
+    const limits = `${ent.ai_systems===null?'Unlimited':ent.ai_systems} AI systems · ${ent.docs_per_month===null?'unlimited':ent.docs_per_month} document generations/month · ${seats} seat${seats===1?'':'s'} · training: ${plan.training_tier}`;
+
+    if(r.active && r.status === 'pack'){
+      const exp = plan.expires_at ? new Date(plan.expires_at).toLocaleDateString() : '—';
+      content.innerHTML = `
+        <div style="display:flex;align-items:center;gap:1rem;padding:1rem;background:#d4edda;border:1px solid #c3e6cb;border-radius:8px;margin-bottom:1rem">
+          <span style="font-size:1.4rem">✓</span>
+          <div style="flex:1">
+            <div style="font-weight:600;color:#155724">${esc(plan.plan_name)} (pay once)</div>
+            <div style="font-size:.85rem;color:#155724">Access until ${exp} &bull; ${esc(limits)}</div>
+          </div>
+        </div>
+        <p style="font-size:.85rem;color:#718096">Need more seats or a longer term? Buy another pack below or move to a subscription; your progress and evidence are kept.</p>`;
+      document.getElementById('subPlansSection').style.display = 'block';
+    } else if(r.active){
+      const endDate = r.currentPeriodEnd ? new Date(r.currentPeriodEnd*1000).toLocaleDateString() : '—';
+      content.innerHTML = `
+        <div style="display:flex;align-items:center;gap:1rem;padding:1rem;background:#d4edda;border:1px solid #c3e6cb;border-radius:8px;margin-bottom:1.25rem">
+          <span style="font-size:1.4rem">✓</span>
+          <div style="flex:1">
+            <div style="font-weight:600;color:#155724">${esc(plan.plan_name)} &bull; Active subscription</div>
+            <div style="font-size:.85rem;color:#155724">Status: ${esc(r.status)} &bull; Next billing: ${endDate}${r.cancelAtPeriodEnd ? ' &bull; <span style="color:#c53030;font-weight:600">Cancels at period end</span>' : ''}<br>${esc(limits)}</div>
+          </div>
+        </div>
+        <div style="display:flex;gap:.75rem;flex-wrap:wrap">
+          <button class="btn btn-primary" onclick="openPortal()">Manage subscription &amp; seats</button>
+          <button class="btn btn-outline" onclick="openPortal()">Update payment method</button>
+          <button class="btn btn-outline" onclick="openPortal()">View invoices</button>
+        </div>`;
+      document.getElementById('subPlansSection').style.display = 'none';
+    } else {
+      const expiredNote = plan.expired ? ` Your ${esc(plans_name(plan.purchased_plan))} pack expired on ${new Date(plan.expires_at).toLocaleDateString()}.` : '';
+      content.innerHTML = `
+        <div style="display:flex;align-items:center;gap:1rem;padding:1rem;background:#fff3cd;border:1px solid #ffeaa7;border-radius:8px">
+          <span style="font-size:1.4rem">⚠</span>
+          <div>
+            <div style="font-weight:600;color:#856404">Free plan</div>
+            <div style="font-size:.85rem;color:#856404">${esc(limits)}. No certificates, evidence report or checklist tracking.${expiredNote}</div>
+          </div>
+        </div>`;
+      document.getElementById('subPlansSection').style.display = 'block';
+    }
+    await loadPlans(plan);
+  } catch(e) {
+    document.getElementById('subStatusLoading').style.display = 'none';
+    document.getElementById('subStatusContent').style.display = 'block';
+    document.getElementById('subStatusContent').innerHTML = '<p style="color:#c53030">Failed to load subscription status.</p>';
+  }
+}
+function plans_name(id){const p=billingPlans.find(x=>x.id===id);return p?p.name:(id||'');}
+async function loadPlans(current){
+  try{
+    const r = await(await fetch('/api/billing/plans',{credentials:'include'})).json();
+    billingPlans = r.plans || [];
+    document.getElementById('planGrid').innerHTML = billingPlans.filter(p=>p.kind!=='pack').map(p=>planCard(p,current)).join('');
+    document.getElementById('packGrid').innerHTML = billingPlans.filter(p=>p.kind==='pack').map(p=>planCard(p,current)).join('');
+  }catch(e){ console.error('Plans failed', e); }
+}
+async function checkout(planId){
+  const seatsEl = document.getElementById('seats_'+planId);
+  const body = {plan_id: planId};
+  if(seatsEl) body.seats = parseInt(seatsEl.value,10);
+  try{
+    const r = await fetch('/api/billing/checkout',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
+    const d = await r.json();
+    if(!r.ok){ alert(d.error||'Checkout failed'); return; }
+    window.location.href = d.url;
+  }catch(e){ alert(e.message); }
+}
+
+async function openPortal(){
+  try{
+    const r = await(await fetch('/api/subscription/portal-url',{credentials:'include'})).json();
+    if(r.url) window.location.href = r.url;
+    else alert('Failed to open billing portal');
+  } catch(e) { alert(e.message); }
+}
+
+// ═══════════════════════════════════════════════════════════════
+// UTILITIES
+// ═══════════════════════════════════════════════════════════════
+function openModal(id){document.getElementById(id).classList.add('open')}
+function closeModal(id){document.getElementById(id).classList.remove('open')}
+function esc(s){if(!s)return'';const d=document.createElement('div');d.textContent=s;return d.innerHTML}
+</script>
